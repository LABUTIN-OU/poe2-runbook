: \"skill-skeletal-brute\", \"need\": \"maps-70\"},\r\n    {\"id\": \"skill-skeletal-cleric\", \"kind\": \"skill\", \"group\": \"Навыки\", \"title\": \"Скелет-клерик (Skeletal Cleric)\", \"need\": \"maps-65\"},\r\n    {\"id\": \"support-last-gasp-skeletal-cleric\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Последний вздох (Last Gasp)\", \"for\": \"skill-skeletal-cleric\", \"need\": \"maps-65\"},\r\n    {\"id\": \"gem16-skeletal-cleric\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"16\", \"for\": \"skill-skeletal-cleric\", \"need\": \"maps-70\"},\r\n    {\"id\": \"skill-spectre-powered-zealot\", \"kind\": \"skill\", \"group\": \"Навыки\", \"title\": \"Призрак: Заряженный подвижник (Spectre: Powered Zealot)\", \"gemFrom\": 7, \"need\": \"ravine\"},\r\n    {\"id\": \"gem11-spectre-powered-zealot\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"11\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"ravine\"},\r\n    {\"id\": \"gem13-spectre-powered-zealot\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"13\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"crossing\"},\r\n    {\"id\": \"gem16-spectre-powered-zealot\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"16\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"maps-70\"},\r\n    {\"id\": \"support-feeding-frenzy-2-spectre\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Голодное остервенение II (Feeding Frenzy II)\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"maps\"},\r\n    {\"id\": \"support-muster-spectre\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Сборище (Muster)\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"maps\"},\r\n    {\"id\": \"support-wildshards-spectre\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Шальные осколки II (Wildshards II)\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"maps\"},\r\n    {\"id\": \"support-pierce-3-spectre\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Пронзание III (Pierce III)\", \"for\": \"skill-spectre-powered-zealot\", \"need\": \"maps-65\"},\r\n    {\"id\": \"support-projectile-acceleration-2-spectre\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Ускорение снарядов II (Projectile Acceleration II)\", \"for\": \"skill-spectre-powered-zealot\"},\r\n    {\"id\": \"skill-convalescence\", \"kind\": \"skill\", \"group\": \"Навыки\", \"title\": \"Оздоровление (Convalescence)\", \"need\": \"freythorn\"},\r\n    {\"id\": \"support-prolonged-duration-ii-convalescence\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Продление I (Prolonged Duration I)\", \"for\": \"skill-convalescence\", \"need\": \"chaos\"},\r\n    {\"id\": \"support-second-wind-i-convalescence\", \"kind\": \"support\", \"group\": \"Навыки\", \"title\": \"Второе дыхание I (Second Wind I)\", \"for\": \"skill-convalescence\", \"need\": \"chaos\"},\r\n    {\"id\": \"gem9-convalescence\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"9\", \"for\": \"skill-convalescence\", \"need\": \"chaos\"},\r\n    {\"id\": \"gem10-convalescence\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"10\", \"for\": \"skill-convalescence\", \"need\": \"azak\"},\r\n    {\"id\": \"gem12-convalescence\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"12\", \"for\": \"skill-convalescence\", \"need\": \"halls\"},\r\n    {\"id\": \"gem14-convalescence\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"14\", \"for\": \"skill-convalescence\", \"need\": \"maps\"},\r\n    {\"id\": \"gem16-convalescence\", \"kind\": \"gem\", \"group\": \"Навыки\", \"part\": \"level\", \"title\": \"16\", \"for\": \"skill-convalescence\", \"need\": \"maps-70\"},\r\n    {\"id\": \"weapon-piece-1\", \"kind\": \"resource\", \"group\": \"Ресурсы\", \"title\": \"Часть оружия 1 из 3\", \"heard\": \"SinA4_Wild_FirstPieceAfterConvo\", \"need\": \"arastas\"},\r\n    {\"id\": \"weapon-piece-2\", \"kind\": \"resource\", \"group\": \"Ресурсы\", \"title\": \"Часть оружия 2 из 3\", \"heard\": \"SinA4_Wild_SecondPieceAfterConvo\", \"need\": \"arastas\"},\r\n    {\"id\": \"weapon-piece-3\", \"kind\": \"resource\", \"group\": \"Ресурсы\", \"title\": \"Часть оружия 3 из 3\", \"heard\": \"SinA4_Wild_ThirdPieceAfterConvo\", \"need\": \"arastas\"},\r\n    {\"id\": \"gold-7000\", \"kind\": \"resource\", \"group\": \"Ресурсы\", \"title\": \"7000 золота\", \"need\": \"after-ascension\"},\r\n    {\"id\": \"gold-150000\", \"kind\": \"resource\", \"group\": \"Ресурсы\", \"title\": \"150 000 золота\", \"need\": \"maps\"},\r\n    {\"id\": \"es-vile-robe\", \"slot\": \"body\", \"part\": \"es\", \"label\": \"энергощит доспеха\", \"stat\": \"es\", \"min\": 400, \"title\": \"от 400\", \"note\": \"Нечестивое облачение (Vile Robe): база с 65 уровня, 121 интеллекта. Префикс «+N к максимуму энергетического щита» и Большая сущность улучшения (Greater Essence of Enhancement, 68–79%) дают около 480. По гайду сборки: с таким доспехом можно целиком переходить с брони на энергощит.\", \"need\": \"maps-70\", \"probe\": {\"Class\": \"Body Armours\", \"BaseType\": \"Vile Robe\", \"Rarity\": \"Normal\", \"DropLevel\": 65}},\r\n    {\"id\": \"focus-minion-levels\", \"title\": \"Фокус 65 уровня предмета: +2 к уровню умений приспешников\", \"note\": \"Суффикс ставится очернением: Сохранившееся ребро (Preserved Rib) или Древнее ребро (Ancient Rib) и Предзнаменование отголосков Бездны (Omen of Abyssal Echoes). Обглоданное ребро (Gnawed Rib) не годится: оно до 64 уровня предмета.\", \"need\": \"maps-75\"},\r\n    {\"id\": \"chaos-inoculation\", \"title\": \"Иммунитет к хаосу (Chaos Inoculation)\", \"note\": \"Узел оставляет 1 здоровья: до 6000 энергощита в окне героя не брать, очко пусть ждёт. Дерево этапа «Карты» даёт +316% энергощита, поэтому 6000 — это около 1420 энергощита на предметах, 7000 — около 1660. Щит в это время ещё на руке, фокус не в счёт. Крафт на базах 65 уровня предмета (префикс «+N к максимуму энергетического щита», Большая сущность улучшения, качество 20%): доспех около 515, шлем 325, сапоги 255, перчатки 205 — вместе около 1300, это примерно 5500 на герое. До 6000 дотягивает префикс амулета «39–44% увеличение максимума энергетического щита» (с 65 уровня предмета).\", \"node\": \"passive_keystone_chaos_inoculation\", \"need\": \"maps-75\"},\r\n    {\"id\": \"fourth-teaching\", \"title\": \"Четвёртое учение (The Fourth Teaching)\", \"note\": \"Узел восхождения Ученицы Варашты (Disciple of Varashta): 60% текущего энергетического щита добавляется к броне при расчёте уменьшения физического урона. После него и Иммунитета к хаосу щит меняется на фокус.\", \"need\": \"maps-75\"}\r\n  ]\r\n}\r\n"
}